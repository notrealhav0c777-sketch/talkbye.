# Públicas (podem ir ao navegador)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SECRETAS (somente servidor — nunca use o prefixo NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
# Texto aleatório longo. Gere com: openssl rand -hex 32
GHOST_PEPPER=troque-por-um-valor-aleatorio-longo

# Chamadas de voz/vídeo (LiveKit Cloud ou próprio) — sem isso, as chamadas ficam indisponíveis
NEXT_PUBLIC_LIVEKIT_URL=wss://seu-projeto.livekit.cloud
LIVEKIT_API_KEY=sua-api-key
LIVEKIT_API_SECRET=seu-api-secret
